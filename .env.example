# ─────────────────────────────────────────────────────────────────────────────
# JARVIS configuration — copy to .env and fill in what you use.
#   cp .env.example .env        (Windows:  copy .env.example .env)
# Never commit .env. Everything here is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1                 # keep 127.0.0.1 unless you really want LAN access
PORT=8000
# API token for every route except /health. Generated automatically on first run.
# JARVIS_API_TOKEN=
# Browser origins allowed to call the API (comma separated). Empty = none.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# ── Language models ("provider/model") ───────────────────────────────────────
# Providers: gemini, groq, openai, anthropic, openrouter, deepseek, ollama, lmstudio
# Gemini Flash for chat and actions. gemini-3.5-flash-lite is not the default: it was unusably slow when
# measured on 2026-11-03 (18 s for a 1-token reply).
DEFAULT_MODEL=gemini/gemini-3.5-flash
FAST_MODEL=gemini/gemini-3.5-flash
LLM_FALLBACKS=groq/openai/gpt-oss-120b
# Model for the intent step (empty disables it), its fallback, and the model for action turns.
# The intent step runs on every message that isn't an instant command and sends the last few turns
# (INTENT_HISTORY_TURNS, any channel) plus the current task to INTENT_MODEL's provider.
# Intent step: Groq gpt-oss-120b (fast), Gemini Flash behind it. Free-tier quota: each Groq organisation allows
# 8,000 tokens/minute and 1,000 requests/day; JARVIS rotates through GROQ_API_KEYS on 429, so keys from separate
# Groq organisations add capacity. Gemini's free limits are per Google Cloud project.
INTENT_MODEL=groq/openai/gpt-oss-120b
INTENT_FALLBACK_MODEL=gemini/gemini-3.5-flash
ACTION_MODEL=gemini/gemini-3.5-flash
# reasoning_effort per model name, as a JSON object (lower = faster)
REASONING_EFFORT={"gemini-3.5-flash-lite":"minimal","gemini-3.5-flash":"minimal","openai/gpt-oss-120b":"low"}
# Keep the provider connections warm while idle (lists models: no tokens used), only within 15 min of the
# last request, never offline or with PRIVACY_MODE=local
LLM_KEEPWARM=true
# Optional Langfuse traces of each turn (pip install .[tracing]); leave host empty for Langfuse Cloud
# When enabled, your query, JARVIS's reply and the rewritten request text are sent to the Langfuse host
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# A task with no activity for this long is shelved (say "continue" to bring it back)
TASK_IDLE_SECONDS=900
# Agent rounds per turn: questions/chat, and action turns (multi-step tasks)
AGENT_MAX_STEPS=5
AGENT_MAX_STEPS_ACTION=15
# Recent turns (any channel) the intent step sees, and how far back to look
INTENT_HISTORY_TURNS=4
INTENT_HISTORY_WINDOW_SECONDS=1800
TEMPERATURE=0.2
MAX_TOKENS=1024
TIMEOUT_SECONDS=30

# At least one key OR a running Ollama / LM Studio is needed for conversation.
GEMINI_API_KEY=
# Optional extra Gemini keys, comma separated. When a key runs out of quota (429) or is
# rejected, JARVIS switches to the next one before falling back to another provider.
# Free limits are per Google Cloud project: only keys from different projects add quota.
GEMINI_API_KEYS=
GROQ_API_KEY=
# Optional extra Groq keys, comma separated, rotated on 429 / rejected key. Limits are per Groq organisation,
# so keys from the same account share one limit; keys from separate organisations add capacity.
GROQ_API_KEYS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_VISION_MODEL=qwen3-vl:2b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ── Privacy & safety ─────────────────────────────────────────────────────────
# local = file contents and screenshots are only ever sent to Ollama / LM Studio
PRIVACY_MODE=cloud
DRY_RUN=false                  # true = simulate every action
CONFIRM_MEDIUM_RISK=true       # ask before clicking/typing in apps (incl. keys/typing the model chooses), writing files
# ask before shutdown, kill, delete, send, shell. false = full control: JARVIS does these WITHOUT asking.
# MEDIUM/HIGH actions and any typing / key press requested by MCP clients (other programs) always wait for
# your approval, whatever these two say (their LOW actions, e.g. opening an app, run directly).
CONFIRM_HIGH_RISK=true
CONFIRMATION_TTL_SECONDS=60
POWER_ACTION_DELAY_SECONDS=30  # shutdown/restart countdown ("cancel shutdown" aborts)

# ── Memory ───────────────────────────────────────────────────────────────────
# Local embedding model for semantic memory search (fastembed, ONNX on CPU; downloaded once
# into data/models on first start). Without it, memory search falls back to keyword (FTS5) only.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Similarity (0-1) a past turn needs before it is recalled into the prompt (0.6 suits bge-base;
# re-tune if you change EMBEDDING_MODEL)
MEMORY_RECALL_MIN_SCORE=0.6

# ── Background services (reminders, health alerts, clipboard history) ────────
BACKGROUND_SERVICES=true
HEALTH_CPU_ALERT=92
HEALTH_RAM_ALERT=92
HEALTH_DISK_ALERT=95
HEALTH_BATTERY_ALERT=15

# ── Voice ────────────────────────────────────────────────────────────────────
STT_ENGINE=auto                # auto | faster_whisper | google
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | distil-large-v3 …
TTS_ENGINE=auto                # auto | kokoro | pyttsx3
WAKE_WORD_ENGINE=text          # text | openwakeword
WAKE_WORD_ENABLED=true
SILENCE_TIMEOUT_MS=600         # pause that ends a spoken command (lower = snappier, higher = more patient)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
