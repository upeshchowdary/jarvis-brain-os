# ─────────────────────────────────────────────────────────────────────────────
# JARVIS configuration — copy to .env and fill in what you use.
#   cp .env.example .env        (Windows:  copy .env.example .env)
# Never commit .env. Everything here is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1                 # keep 127.0.0.1 unless you really want LAN access
PORT=8000
# API token for every route except /health. Generated automatically on first run.
# JARVIS_API_TOKEN=
# Browser origins allowed to call the API (comma separated). Empty = none.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# ── Language models ("provider/model") ───────────────────────────────────────
# Providers: gemini, groq, openai, anthropic, openrouter, deepseek, ollama, lmstudio
DEFAULT_MODEL=gemini/gemini-3.5-flash-lite
FAST_MODEL=gemini/gemini-3.5-flash-lite
LLM_FALLBACKS=groq/llama-3.3-70b-versatile,openai/gpt-4o-mini,ollama/qwen3.5:latest
TEMPERATURE=0.2
MAX_TOKENS=1024
TIMEOUT_SECONDS=30

# At least one key OR a running Ollama / LM Studio is needed for conversation.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_VISION_MODEL=qwen3-vl:2b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ── Privacy & safety ─────────────────────────────────────────────────────────
# local = file contents and screenshots are only ever sent to Ollama / LM Studio
PRIVACY_MODE=cloud
DRY_RUN=false                  # true = simulate every action
CONFIRM_MEDIUM_RISK=true       # ask before clicking/typing in apps, writing files
CONFIRMATION_TTL_SECONDS=60
POWER_ACTION_DELAY_SECONDS=30  # shutdown/restart countdown ("cancel shutdown" aborts)

# ── Background services (reminders, health alerts, clipboard history) ────────
BACKGROUND_SERVICES=true
HEALTH_CPU_ALERT=92
HEALTH_RAM_ALERT=92
HEALTH_DISK_ALERT=95
HEALTH_BATTERY_ALERT=15

# ── Voice ────────────────────────────────────────────────────────────────────
STT_ENGINE=auto                # auto | faster_whisper | google
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | distil-large-v3 …
TTS_ENGINE=auto                # auto | kokoro | pyttsx3
WAKE_WORD_ENGINE=text          # text | openwakeword
WAKE_WORD_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
